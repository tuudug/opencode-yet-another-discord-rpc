# Discord Rich Presence Configuration
# Create a Discord application at https://discord.com/developers/applications
# Copy the Application ID and set it below
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_ID_HERE

# Required art assets (upload to your Discord app's Rich Presence → Art Assets page):
#   opencode  — Main logo (1024x1024px)
#   busy      — Working status badge (512x512px)
#   idle      — Idle status badge (512x512px)
#   retry     — Retrying status badge (512x512px)
#   error     — Error status badge (512x512px)

# ──────────────────────────────────────────────────────
# PREFERRED: Set clientId in .opencode/config.json instead:
#
# {
#   "plugin": [
#     [".opencode/plugins/discord-rich-presence.ts", { "clientId": "YOUR_DISCORD_APPLICATION_ID_HERE" }]
#   ]
# }
# ──────────────────────────────────────────────────────